# --- Vertex AI (required for content + image generation) ---
# Option A (recommended): GCP project + Application Default Credentials
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Option B: Vertex Express / API key
# VERTEX_API_KEY=

# Optional model overrides
# VERTEX_TEXT_MODEL=gemini-2.5-flash
# VERTEX_IMAGE_MODEL=gemini-2.5-flash-image
# VERTEX_IMAGEN_MODEL=imagen-3.0-generate-002
# VERTEX_VIDEO_MODEL=veo-3.1-fast-generate-preview

# Optional: leave empty to use Vite proxy to the local API
# VITE_API_URL=

# --- Backend ---
PORT=4000
FRONTEND_URL=http://localhost:3000
# Production: set NODE_ENV=production and a long random JWT_SECRET
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
MONGODB_URI=mongodb://localhost:27017/nexora
# REQUIRE_MONGO=true

# App login (bootstraps first admin when no users exist)
APP_ADMIN_EMAIL=admin@yourcompany.com
APP_ADMIN_PASSWORD=change-me-min-8-chars
# APP_ALLOW_REGISTER=true

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# Instagram / Meta
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/auth/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=nexora_ig_verify

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=nexora_ig_verify
LEAD_HANDOFF_EMAIL=specialists@nexora.example

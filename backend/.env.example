# LinkedIn OAuth (from LinkedIn Developer Portal)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# Instagram Graph API (Meta Developer App)
# 1) Create app at https://developers.facebook.com/
# 2) Add Facebook Login + Instagram Graph API products
# 3) Valid OAuth Redirect URI: http://localhost:3000/auth/instagram/callback
# 4) Instagram account must be Business/Creator linked to a Facebook Page
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/auth/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=nexora_ig_verify
# Public https URL Meta can fetch for Instagram images (e.g. ngrok)
# PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# App
PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me-in-production
MONGODB_URI=mongodb://localhost:27017/nexora

# Vertex AI (Option A — recommended)
VERTEX_PROJECT_ID=diagonisticcenter
VERTEX_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Vertex AI (Option B — API key / express)
# VERTEX_API_KEY=

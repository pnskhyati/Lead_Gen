# LinkedIn OAuth (from LinkedIn Developer Portal)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# Instagram Graph API (Meta Developer App)
# 1) Create app at https://developers.facebook.com/
# 2) Add Facebook Login + Instagram Graph API products
# 3) Valid OAuth Redirect URI: http://localhost:3000/auth/instagram/callback
# 4) Instagram account must be Business/Creator linked to a Facebook Page
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/auth/instagram/callback

# X (Twitter) API v2 — OAuth 2.0 PKCE (Developer Portal → Projects → User authentication)
# Callback URL: https://127.0.0.1:3000/auth/x/callback (match FRONTEND_URL + /auth/x/callback)
# Scopes: tweet.read tweet.write users.read offline.access
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=https://127.0.0.1:3000/auth/x/callback
META_WEBHOOK_VERIFY_TOKEN=nexora_ig_verify
# Public https URL Meta can fetch for Instagram images (e.g. ngrok)
# PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Lead agent — human handoff email (included in mailto drafts)
LEAD_HANDOFF_EMAIL=specialists@nexora.example

# Email channel (SMTP outbound + POST /api/email/inbound webhook)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=hello@yourdomain.com
EMAIL_FROM_NAME=Tecavy
# Optional: require X-Email-Webhook-Secret header on inbound webhook
# EMAIL_WEBHOOK_SECRET=
# PUBLIC_API_BASE=https://your-api.example.com

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=nexora_ig_verify

# Google Ads — lead forms → CRM (POST webhook; optional OAuth sync)
# GOOGLE_ADS_WEBHOOK_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=1234567890

# SEO / GEO — Google Search Console + Business Profile (OAuth)
# Create OAuth client in Google Cloud Console; enable Search Console API + Business Profile APIs
# Authorized redirect URI: http://localhost:4000/api/seo-geo/oauth/callback
# GOOGLE_SEO_CLIENT_ID=
# GOOGLE_SEO_CLIENT_SECRET=
# GOOGLE_SEO_OAUTH_REDIRECT_URI=http://localhost:4000/api/seo-geo/oauth/callback

# SEO / GEO — full crawl, rank sampling, scheduler, WordPress auto-fix
# SEO_GEO_CRAWL_MAX_URLS=500
# SEO_GEO_CRAWL_HARD_CAP=2000
# SEO_GEO_CRAWL_DELAY_MS=250
# SEO_GEO_CRAWL_CONCURRENCY=3
# SERPAPI_KEY=   # optional sampled SERP positions (not guaranteed rank)
# SEO_GEO_SCHEDULER=off
# SEO_GEO_RANK_CRON=0 6 * * *
# SEO_GEO_CITATION_CRON=0 7 * * *
# WORDPRESS_SITE_URL=https://yoursite.com
# WORDPRESS_APP_USER=
# WORDPRESS_APP_PASSWORD=

# Google Sheets — append new CRM leads
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_TAB=Leads
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# App
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
MONGODB_URI=mongodb://localhost:27017/nexora
# REQUIRE_MONGO=true

# First admin (created automatically if no users exist)
APP_ADMIN_EMAIL=admin@yourcompany.com
APP_ADMIN_PASSWORD=change-me-min-8-chars
# APP_ALLOW_REGISTER=false

# Vertex AI — same auth for copilot, lead agent, SEO/GEO AI visibility (no JSON key if org blocks SA keys)
VERTEX_PROJECT_ID=marketing-os-513012
# Agent Platform / Gemini Enterprise: use global + gemini-3-flash-preview (see Google locations doc).
VERTEX_LOCATION=global
VERTEX_TEXT_MODEL=gemini-3-flash-preview
VERTEX_IMAGE_MODEL=gemini-2.5-flash-image
# Default: Vertex ADC when VERTEX_PROJECT_ID is set. Optional AI Studio key fallback:
# GEMINI_USE_GEMINI_API=true
# GEMINI_API_KEY=
# Auth (pick one):
# 1) Application Default Credentials (recommended): gcloud auth application-default login
# 2) Service account file (if org allows): GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# 3) Express API key: VERTEX_API_KEY=
# Requires billing on the GCP project + aiplatform.googleapis.com enabled.
